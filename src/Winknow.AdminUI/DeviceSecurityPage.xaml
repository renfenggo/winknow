<UserControl x:Class="Winknow.AdminUI.DeviceSecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="820">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 操作行 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AssessBtn" Content="开始检测" Width="110" Height="30" Click="OnAssessClick" Margin="0,0,8,0"/>
            <Button x:Name="ExportBtn" Content="导出报告 (MD/CSV)" Width="140" Height="30" Click="OnExportClick" Margin="0,0,8,0" IsEnabled="False"/>
            <TextBlock x:Name="AssessStatusText" VerticalAlignment="Center" Text="尚未检测"/>
        </StackPanel>

        <!-- 评分摘要 -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="评分：" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="ScoreText" Text="--" FontSize="28" FontWeight="Bold" Foreground="#D9534F" VerticalAlignment="Center" Margin="4,0,16,0"/>
                <TextBlock Text="等级：" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="GradeTextBlock" Text="未评估" FontSize="16" VerticalAlignment="Center" Margin="4,0,16,0"/>
                <TextBlock Text="Secure Boot：" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="SecureBootTextBlock" Text="Unknown" VerticalAlignment="Center" Margin="4,0,16,0"/>
                <TextBlock Text="核验记录：" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="VerificationTextBlock" Text="从未核验" VerticalAlignment="Center" Margin="4,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 固件信息 -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <TextBlock x:Name="FirmwareTextBlock" Text="固件信息：未采集" TextWrapping="Wrap"/>
        </Border>

        <!-- 检查项明细 -->
        <DataGrid Grid.Row="3" x:Name="ChecksGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="检查项" Binding="{Binding Title}" Width="240"/>
                <DataGridTextColumn Header="类别" Binding="{Binding CategoryText}" Width="80"/>
                <DataGridTextColumn Header="权重" Binding="{Binding Weight}" Width="50"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90"/>
                <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 人工核验操作 -->
        <Border Grid.Row="4" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="人工核验：选中上方类别为『人工核验』的行，填写管理员与备注后记录结论" FontWeight="Bold" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="管理员：" VerticalAlignment="Center"/>
                    <TextBox x:Name="AdminNameBox" Width="120" VerticalContentAlignment="Center" Margin="4,0,12,0"/>
                    <TextBlock Text="备注：" VerticalAlignment="Center"/>
                    <TextBox x:Name="NoteBox" Width="220" VerticalContentAlignment="Center" Margin="4,0,12,0"/>
                    <Button x:Name="MarkPassBtn" Content="记为通过" Width="90" Height="28" Click="OnMarkPassClick" Margin="0,0,8,0"/>
                    <Button x:Name="MarkFailBtn" Content="记为未通过" Width="90" Height="28" Click="OnMarkFailClick"/>
                </StackPanel>
                <TextBlock x:Name="RiskTextBlock" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#B85C00"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
