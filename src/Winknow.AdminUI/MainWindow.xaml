<Window x:Class="Winknow.AdminUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Winknow.AdminUI"
        mc:Ignorable="d"
        Title="Winknow 管理控制台" Height="320" Width="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Winknow V7.0 管理控制台" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <Button Grid.Row="1" x:Name="EnterMaintenanceBtn" Content="进入维护模式"
                Width="200" Height="40" Click="OnEnterMaintenanceClick" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" x:Name="StatusText" Text="未进入维护模式" Margin="0,8,0,0"/>

        <Button Grid.Row="4" x:Name="ExitMaintenanceBtn" Content="退出维护模式"
                Width="200" Height="40" Click="OnExitMaintenanceClick"
                IsEnabled="False" HorizontalAlignment="Left"/>
    </Grid>
</Window>
