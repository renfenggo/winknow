<Page x:Class="Winknow.AdminUI.ClassroomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="课堂总览">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部：标题和统计信息 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="15" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="课堂总览" FontSize="24" FontWeight="SemiBold" Foreground="#333"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Border Background="#4CAF50" Padding="10,5" CornerRadius="3" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="在线:" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OnlineCount" Text="0" Foreground="White" FontWeight="SemiBold" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF9800" Padding="10,5" CornerRadius="3" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="宽限中:" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GraceCount" Text="0" Foreground="White" FontWeight="SemiBold" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F44336" Padding="10,5" CornerRadius="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="锁定:" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LockedCount" Text="0" Foreground="White" FontWeight="SemiBold" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 设备列表 -->
        <DataGrid Grid.Row="1"
                  x:Name="DevicesGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionChanged="DevicesGrid_SelectionChanged"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#FAFAFA">

            <DataGrid.Columns>
                <DataGridTextColumn Header="设备ID" Binding="{Binding DeviceId}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="学生姓名" Binding="{Binding StudentName}" Width="1*" IsReadOnly="True"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="1*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding StatusColor}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="最后心跳" Binding="{Binding LastSeenDisplay}" Width="1*" IsReadOnly="True"/>
                <DataGridTextColumn Header="锁定时间" Binding="{Binding LockedAtDisplay}" Width="1*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部：操作按钮 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton"
                        Content="刷新状态"
                        Padding="15,8"
                        Margin="0,0,10,0"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        Click="RefreshButton_Click"/>

                <Button x:Name="GenerateCodeButton"
                        Content="生成解锁码"
                        Padding="15,8"
                        Margin="0,0,10,0"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        IsEnabled="False"
                        Click="GenerateCodeButton_Click"/>

                <Button x:Name="UnlockButton"
                        Content="解锁设备"
                        Padding="15,8"
                        Margin="0,0,10,0"
                        Background="#FF9800"
                        Foreground="White"
                        BorderThickness="0"
                        IsEnabled="False"
                        Click="UnlockButton_Click"/>

                <Button x:Name="LockButton"
                        Content="锁定设备"
                        Padding="15,8"
                        Background="#F44336"
                        Foreground="White"
                        BorderThickness="0"
                        IsEnabled="False"
                        Click="LockButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>