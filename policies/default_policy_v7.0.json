  "softwareControl": {
    "whitelist": {
      "byPublisher": [
        "Microsoft Corporation",
        "Microsoft"
      ],
      "byPath": [
        {
          "path": "C:\\Program Files\\Microsoft Visual Studio\\*",
          "hash": "",
          "description": "Visual Studio"
        },
        {
          "path": "C:\\Program Files (x86)\\Microsoft Visual Studio\\*",
          "hash": "",
          "description": "Visual Studio (x86)"
        },
        {
          "path": "C:\\Program Files\\Microsoft VS Code\\*",
          "hash": "",
          "description": "VS Code \u7CFB\u7EDF\u7EA7\u5B89\u88C5"
        },
        {
          "path": "C:\\Users\\*\\AppData\\Local\\Programs\\Microsoft VS Code\\*",
          "hash": "",
          "description": "VS Code \u7528\u6237\u7EA7\u5B89\u88C5"
        },
        {
          "path": "C:\\Program Files\\Dev-Cpp\\*",
          "hash": "",
          "description": "Dev-C\u002B\u002B IDE \u53CA\u5DE5\u5177\u94FE(gcc/g\u002B\u002B/gdb)"
        },
        {
          "path": "C:\\Program Files\\Google\\Chrome\\Application\\*",
          "hash": "",
          "description": "Chrome \u6D4F\u89C8\u5668"
        },
        {
          "path": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\*",
          "hash": "",
          "description": "Edge \u6D4F\u89C8\u5668"
        }
      ],
      "byHash": []
    },
    "studentOutput": {
      "allowedDirectories": [
        "C:\\Users\\*\\source\\repos\\**",
        "C:\\Dev-Cpp\\Projects\\**"
      ],
      "maxValidityHours": 2,
      "maxFileSizeMB": 50
    },
    "highRiskInterpreters": {
      "blocked": [
        "powershell.exe",
        "wscript.exe",
        "cscript.exe",
        "mshta.exe",
        "regedit.exe",
        "mmc.exe"
      ]
    },
    "runnerExemptions": {
      "enabled": true,
      "trustedToolchainPaths": [
        "C:\\Program Files (x86)\\Dev-Cpp\\**"
      ],
      "workspaceRoot": "C:\\ProgramData\\Winknow\\runner",
      "maxSessionMinutes": 120
    }
  },
  "networkControl": {
    "websiteWhitelist": {
      "domains": [
        "luogu.com.cn",
        "*.luogu.com.cn",
        "cdn.luogu.com.cn",
        "www.luogu.com.cn"
      ]
    },
    "proxy": {
      "allowed": false,
      "forceSystemProxy": true,
      "pac": {
        "allowed": false,
        "autoConfigUrl": ""
      },
      "failMode": "strict"
