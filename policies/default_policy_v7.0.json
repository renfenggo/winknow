{
  "Version": "7.0.0",
  "PolicyId": "default-classroom-v1",
  "CreatedAt": "2026-08-07T00:00:00Z",
  "Description": "编程课堂默认策略 - 适用于 V7.0",
  "SoftwareControl": {
    "Whitelist": {
      "ByPublisher": [
        "Microsoft Corporation",
        "Microsoft"
      ],
      "ByPath": [
        {
          "Path": "C:\\Program Files\\Microsoft Visual Studio\\*",
          "Hash": "",
          "Description": "Visual Studio"
        },
        {
          "Path": "C:\\Program Files (x86)\\Microsoft Visual Studio\\*",
          "Hash": "",
          "Description": "Visual Studio (x86)"
        },
        {
          "Path": "C:\\Program Files\\Microsoft VS Code\\*",
          "Hash": "",
          "Description": "VS Code 系统级安装"
        },
        {
          "Path": "C:\\Users\\*\\AppData\\Local\\Programs\\Microsoft VS Code\\*",
          "Hash": "",
          "Description": "VS Code 用户级安装"
        },
        {
          "Path": "C:\\Program Files\\Dev-Cpp\\*",
          "Hash": "",
          "Description": "Dev-C++ IDE 及工具链(gcc/g++/gdb)"
        },
        {
          "Path": "C:\\Program Files\\Google\\Chrome\\Application\\*",
          "Hash": "",
          "Description": "Chrome 浏览器"
        },
        {
          "Path": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\*",
          "Hash": "",
          "Description": "Edge 浏览器"
        }
      ],
      "ByHash": []
    },
    "StudentOutput": {
      "AllowedDirectories": [
        "C:\\Users\\*\\source\\repos\\**",
        "C:\\Dev-Cpp\\Projects\\**"
      ],
      "MaxValidityHours": 2,
      "MaxFileSizeMB": 50
    },
    "HighRiskInterpreters": {
      "Blocked": [
        "powershell.exe",
        "wscript.exe",
        "cscript.exe",
        "mshta.exe",
        "regedit.exe",
        "mmc.exe"
      ]
    }
  },
  "NetworkControl": {
    "WebsiteWhitelist": {
      "Domains": [
        "luogu.com.cn",
        "*.luogu.com.cn",
        "cdn.luogu.com.cn",
        "www.luogu.com.cn"
      ]
    },
    "Proxy": {
      "Allowed": false,
      "ForceSystemProxy": true,
      "Pac": {
        "Allowed": false,
        "AutoConfigUrl": ""
      },
      "FailMode": "strict"
    },
    "Dns": {
      "AllowedServers": [],
      "BlockedServers": [
        "8.8.8.8",
        "8.8.4.4",
        "1.1.1.1",
        "1.0.0.1"
      ],
      "BlockDoh": true
    },
    "BrowserPolicy": {
      "Chrome": {
        "DisableCustomProxy": true,
        "DisableDoh": true,
        "DisableSecureDns": true
      },
      "Edge": {
        "DisableCustomProxy": true,
        "DisableDoh": true,
        "DisableSecureDns": true
      }
    },
    "VpnDetection": {
      "BlockedProcesses": [],
      "BlockedServices": [],
      "DetectVirtualAdapters": true
    },
    "WebsiteHealth": {
      "Endpoints": [
        {
          "Name": "洛谷首页",
          "Url": "https://www.luogu.com.cn",
          "ExpectedStatus": 200
        },
        {
          "Name": "洛谷图片CDN",
          "Url": "https://cdn.luogu.com.cn",
          "ExpectedStatus": 0
        },
        {
          "Name": "洛谷登录",
          "Url": "https://www.luogu.com.cn/login",
          "ExpectedStatus": 0
        },
        {
          "Name": "洛谷提交",
          "Url": "https://www.luogu.com.cn/record",
          "ExpectedStatus": 0
        }
      ],
      "TimeoutSeconds": 5,
      "IntervalSeconds": 60
    }
  },
  "UsbControl": {
    "MassStorage": {
      "Enabled": false,
      "AdminOverride": true
    },
    "HidDevices": {
      "Enabled": true
    }
  }
}
